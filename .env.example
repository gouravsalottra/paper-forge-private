# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# ── LLM ──────────────────────────────────────────────────────────
# Primary API key used by all agents (SCOUT, QUILL, HAWK, SIGMA, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: separate key for CODEC Pass 2 to enforce true process isolation.
# If not set, OPENAI_API_KEY is used as fallback.
OPENAI_API_KEY_PASS2=your_optional_second_openai_api_key_here

# ── Data sources ──────────────────────────────────────────────────
# Set to 'wrds' (default, requires WRDS credentials) or 'yfinance' (dev/demo)
PAPER_FORGE_MINER_SOURCE=wrds

# FRED key for macro time series. Leave blank in git-tracked files and set this
# in Azure Container App secrets / env vars for production.
FRED_API_KEY=

# WRDS credentials (required if PAPER_FORGE_MINER_SOURCE=wrds)
WRDS_USERNAME=your_wrds_username

# ── Modal (FORGE GPU compute) ─────────────────────────────────────
# Modal secret name — store OPENAI_API_KEY inside the Modal secret, not here
MODAL_SECRET_NAME=paper-forge-runtime
# Generated analysis code runs in Modal in production. Local is for tests/dev only.
THRIVARC_COMPUTE_BACKEND=modal
MODAL_ACCOUNT_ALIAS=primary
MODAL_ROUTER_ENABLED=1
MODAL_ACCOUNT_ALIASES=primary,secondary,tertiary
MODAL_MONTHLY_BUDGET_USD=28
MODAL_ESTIMATED_USD_PER_SECOND=0.00015
MODAL_APP_NAME=thrivarc-compute
MODAL_FUNCTION_NAME=run_analysis_code
MODAL_EXECUTION_TIMEOUT_SECONDS=900
# API containers call the deployed Modal function by app/function name.
MODAL_USE_DEPLOYED=1
# Store these as Azure Container App secrets/env vars in production.
MODAL_PRIMARY_TOKEN_ID=
MODAL_PRIMARY_TOKEN_SECRET=
MODAL_SECONDARY_TOKEN_ID=
MODAL_SECONDARY_TOKEN_SECRET=
MODAL_TERTIARY_TOKEN_ID=
MODAL_TERTIARY_TOKEN_SECRET=

# ── Pipeline behaviour ────────────────────────────────────────────
# Override episode count for fast dev/test runs (default: 500000)
# PAPER_FORGE_FORGE_EPISODES=500
